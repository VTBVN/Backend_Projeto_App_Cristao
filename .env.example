# Configuração local. Veja docs/operacao.md para variáveis consumidas na T03.
APP_ENV=development
# Preencher localmente; não enviar a URI real ao Git.
MONGODB_URI=
MONGODB_DATABASE=app_cristao_dev
# Em produção, restringir a credencial runtime e usar URI TLS.
# MONGODB_SETUP_URI: fornecer somente ao processo operacional de init-auth/init-cache.
# Proxy local Nginx em produção: TRUSTED_PROXY_IPS=127.0.0.1,::1
# Deixe vazio quando acessar Flask diretamente em desenvolvimento.
TRUSTED_PROXY_IPS=
# Autenticação: origem exata sem barra final; false apenas localhost HTTP em development.
APP_ORIGIN=http://localhost:5173
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=43200
ANONYMOUS_SESSION_TTL_SECONDS=1800
# Upload futuro (T05).
UPLOAD_DIR=instance/uploads
MAX_VIDEO_BYTES=52428800
MAX_REQUEST_BYTES=53477376
MAX_VIDEO_SECONDS=90
FFPROBE_PATH=ffprobe
# Configuração bíblica consumida na T03; tradução é fixa em almeida no código.
BIBLE_API_BASE_URL=https://bible-api.com
BIBLE_CONNECT_TIMEOUT_SECONDS=2
BIBLE_READ_TIMEOUT_SECONDS=5
BIBLE_CACHE_TTL_SECONDS=86400
# Produção: APP_ENV=production, origem HTTPS e SESSION_COOKIE_SECURE=true.
